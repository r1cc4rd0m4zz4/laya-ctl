# laya-ctl environment configuration template
# Copy to ~/.config/laya/.env or to your local project .env

# ==============================================================================
# Memory Profile
# ==============================================================================
# Options:
#   balanced    - (Default) Preloads multilingual & english, keeps max 2 models
#                 resident in RAM (~1.2 - 1.9 GB), evicts LRU on demand and
#                 unloads after 300s of inactivity.
#   performance - Keeps all 3 models resident in RAM permanently (~2.2 GB).
#                 Zero switch latency. Recommended for 32GB+ machines.
#   eco         - Keeps only 1 model resident (~0.9 - 1.2 GB), unloads after 120s.
#                 Recommended for 8-16GB laptops.
LAYA_PROFILE=balanced

# ==============================================================================
# Network & Socket Binding
# ==============================================================================
# Strict loopback binding for local-only zero-trust security
LAYA_HOST=127.0.0.1
LAYA_PORT=5292

# ==============================================================================
# Hardware Device & Acceleration
# ==============================================================================
# Preferred PyTorch device: auto, mps (Apple Silicon), cuda (NVIDIA), or cpu
LAYA_DEVICE=auto

# ==============================================================================
# Granular Overrides (Optional - overrides profile defaults if set)
# ==============================================================================
# Maximum checkpoints resident in RAM at once (1, 2, or 3)
# LAYA_MAX_LOADED=2

# Idle unload window in seconds (0 = disabled, e.g. 300 = 5 minutes)
# LAYA_IDLE_UNLOAD_SECONDS=300

# Comma-separated list of models to preload at startup
# Options: english, multilingual, typed-decisions
# LAYA_MODELS=multilingual,english

# ==============================================================================
# Protocol & Wire Contract Strictness (System One / TypeSafe Jev)
# ==============================================================================
# Set to 1 for strict byte-for-byte TypeSafe Jev wire compatibility.
# Strips Laya-specific routing extensions, x_jev_confidence, and extra usage fields.
# Can also be toggled via CLI: laya-ctl start --strict
# LAYA_JEV_STRICT=0

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Optional bearer token check. If set, requires 'Authorization: Bearer <token>'
# on every /v1/systemone route. If empty, local loopback requests are admitted freely.
# LAYA_API_KEY=
